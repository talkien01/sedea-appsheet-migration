# ---------------------------------------------------------------------------
# SEDEA - Variables de entorno de ejemplo.
# Copia este archivo a .env y reemplaza TODOS los valores "cambiame".
# Este archivo NO contiene secretos reales: son marcadores de posicion.
# ---------------------------------------------------------------------------

# Base de datos
POSTGRES_USER=sedea
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=sedea
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Dentro de Docker el compose inyecta el host "db" automaticamente.
# Este valor lo usan las herramientas de linea de comandos del host
# (npm run migrate / seed / importar), por eso apunta a localhost.
DATABASE_URL=postgres://sedea:cambiame@localhost:5432/sedea

# Backend
PORT=3000
NODE_ENV=production
JWT_SECRET=cambiame-por-un-secreto-largo
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:8080
STORAGE_DRIVER=local
MEDIA_DIR=/app/media
MEDIA_PUBLIC_PATH=/media
MAX_UPLOAD_MB=8
# PDF multipagina de recibos generado por el alimentador del escaner documental.
MAX_CONCILIACION_PDF_MB=40
RATE_LIMIT_MAX=300
# Candado de la operacion irreversible POST /api/admin/reiniciar-datos-prueba.
# Produccion debe permanecer en false. Solo habilitar temporalmente en entornos
# de prueba controlados que realmente deban vaciar los datos capturados.
ALLOW_DESTRUCTIVE_RESET=false

# Pre-dictaminacion con IA (Build 13). Todas tienen default: si faltan, el
# backend arranca igual.
#   simulado          (default) -> no toca la red, determinista. Desarrollo, tests y CI.
#   anthropic                   -> llamadas reales de vision con el SDK de Anthropic.
#   openai_compatible           -> cualquier endpoint que hable Chat Completions
#                                  estilo OpenAI (Qwen-VL, OpenAI, OpenRouter...).
# Con un driver real y sin sus credenciales, el endpoint E55 responde
# 503 ia_no_configurada (el arranque NO falla).
PREDICTAMEN_DRIVER=simulado
# Deja este valor vacio en el repositorio: la llave real solo vive en el .env
# del servidor, nunca en git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Driver openai_compatible (solo si PREDICTAMEN_DRIVER=openai_compatible) ---
# Endpoint compatible con Chat Completions de OpenAI. Sin PREDICTAMEN_API_KEY o
# sin PREDICTAMEN_API_BASE_URL -> 503 ia_no_configurada.
#
# Ejemplo Qwen (Alibaba) via DashScope compatible-mode:
#   PREDICTAMEN_DRIVER=openai_compatible
#   PREDICTAMEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   PREDICTAMEN_API_KEY=sk-...            (llave de DashScope)
#   PREDICTAMEN_MODEL=qwen-vl-max
#
# El MISMO driver sirve para OpenAI cambiando solo estas variables:
#   PREDICTAMEN_API_BASE_URL=https://api.openai.com/v1
#   PREDICTAMEN_MODEL=gpt-4o
PREDICTAMEN_API_BASE_URL=
PREDICTAMEN_API_KEY=
PREDICTAMEN_MODEL=

# PWA (build-time)
VITE_API_URL=/api
VITE_APP_NOMBRE=SISPACQ ver. 5.0
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Seeds demo (solo desarrollo - cambiar en produccion)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=cambiame123
# Contrasena del usuario demo editor1 (rol editor_datos). Si se omite,
# se reutiliza SEED_ADMIN_PASSWORD.
SEED_EDITOR_PASSWORD=cambiame123
# Contrasena de los usuarios demo ventanilla1 y ventanilla2 (rol ventanilla,
# build 6). Si se omite, se reutiliza SEED_ADMIN_PASSWORD.
SEED_VENTANILLA_PASSWORD=cambiame123
# Los usuarios demo de dictamen (dict.test y vent.dict, build 13) reutilizan
# SEED_VENTANILLA_PASSWORD.

# Puertos del host (ajusta si ya estan ocupados)
POSTGRES_PORT_HOST=5432
BACKEND_PORT_HOST=3000
PWA_PORT_HOST=8080
